            "url": "{{baseUrl}}/api/equipes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Equipe Invalida\",\n  \"trechoId\": 4\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Buscar por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/equipes/{{equipeId}}"
          }
        },
        {
          "name": "Equipes disponiveis",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/equipes/disponiveis"
          }
        },
        {
          "name": "Filtro por nome",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/equipes?nome=norte"
          }
        },
        {
          "name": "Atualizar (renomear e desassociar)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/equipes/{{equipeId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Equipe Postman - Plantao\",\n  \"trechoId\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "3. Intervencoes",
      "item": [
        {
          "name": "Listar intervencoes",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/intervencoes"
          }
        },
        {
          "name": "Registrar sem tipo: motor escolhe (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/intervencoes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"trechoId\": {{trechoId}},\n  \"equipeId\": {{equipeId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('intervencaoId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Filtro por tipo (findByTipo)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/intervencoes?tipo=MECANIZADA"
          }
        },
        {
          "name": "Buscar por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/intervencoes/{{intervencaoId}}"
          }
        },
        {
          "name": "Corrigir registro (200)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/intervencoes/{{intervencaoId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo\": \"MECANIZADA\",\n  \"trechoId\": {{trechoId}},\n  \"equipeId\": {{equipeId}},\n  \"dataExecucao\": \"2026-10-01T08:00:00\",\n  \"alturaAntes\": 47.0,\n  \"alturaDepois\": 5.0,\n  \"descricao\": \"Conferido em campo.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Apagar trecho com intervencao (409)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/trechos/{{trechoId}}"
          }
        },
        {
          "name": "Remover intervencao (204)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/intervencoes/{{intervencaoId}}"
          }
        }
      ]
    },
    {
      "name": "4. Relatorios",
      "item": [
