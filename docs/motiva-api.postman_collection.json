{
  "info": {
    "name": "MOTIVA API - Sprint 4",
    "description": "API REST de priorizacao de rocada (Spring Boot + JPA). Rode as pastas em ordem: os POSTs guardam o id criado nas variaveis da colecao (trechoId, equipeId, intervencaoId).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "trechoId",
      "value": "1"
    },
    {
      "key": "equipeId",
      "value": "1"
    },
    {
      "key": "intervencaoId",
      "value": "1"
    },
    {
      "key": "relatorioId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "1. Trechos",
      "item": [
        {
          "name": "Listar trechos",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/trechos"
          }
        },
        {
          "name": "Criar trecho UMIDO (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/trechos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": \"BR101-T\",\n  \"km\": 99.0,\n  \"alturaVegetacao\": 20.0,\n  \"diasSemRocada\": 5,\n  \"tipoTerreno\": \"UMIDO\",\n  \"idSensor\": \"IOT-999\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('trechoId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar por ID (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/trechos/{{trechoId}}"
          }
        },
        {
          "name": "Atualizar (200)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/trechos/{{trechoId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": \"BR101-T\",\n  \"km\": 99.0,\n  \"alturaVegetacao\": 22.0,\n  \"diasSemRocada\": 8,\n  \"tipoTerreno\": \"UMIDO\",\n  \"idSensor\": \"IOT-999-B\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Simular 10 dias de crescimento",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/trechos/{{trechoId}}/simular-crescimento?dias=10"
          }
        },
        {
          "name": "Filtro alturaMinima (derived query)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/trechos?alturaMinima=40"
          }
        },
        {
          "name": "Filtro tipoTerreno (derived query)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/trechos?tipoTerreno=UMIDO"
          }
        },
        {
          "name": "Trechos criticos",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/trechos/criticos"
          }
        },
        {
          "name": "Buscar por codigo",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/trechos/codigo/BR101-T"
          }
        },
        {
          "name": "Intervencoes do trecho",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/trechos/{{trechoId}}/intervencoes"
          }
        },
        {
          "name": "Buscar inexistente (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/trechos/999999"
          }
        },
        {
          "name": "Criar invalido (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/trechos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": \"\",\n  \"km\": -1,\n  \"alturaVegetacao\": -5,\n  \"tipoTerreno\": \"UMIDO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Codigo duplicado (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/trechos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": \"BR101-A\",\n  \"km\": 1,\n  \"alturaVegetacao\": 5,\n  \"tipoTerreno\": \"SECO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "2. Equipes",
      "item": [
        {
          "name": "Listar equipes",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/equipes"
          }
        },
        {
          "name": "Criar equipe no trecho critico (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/equipes",
            "description": "O trecho criado na pasta 1 fica CRITICO depois da simulacao de 10 dias.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Equipe Postman\",\n  \"trechoId\": {{trechoId}}\n}",
