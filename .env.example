# Copie este arquivo para ".env" (mesma pasta do pom.xml) e preencha com o SEU RM.
# O .env e lido pelo application.properties e esta no .gitignore: a senha nunca vai para o GitHub.
# Alternativa: exportar as mesmas variaveis no terminal (export DB_USERNAME=...).

DB_USERNAME=RMxxxxxx
DB_PASSWORD=sua_senha

# Opcional: so mude se o banco nao for o Oracle da FIAP (formato SID: host:porta:SID)
# DB_URL=jdbc:oracle:thin:@oracle.fiap.com.br:1521:ORCL
